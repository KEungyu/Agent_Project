# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# ── AI 모델 키 (둘 중 하나만 있어도 된다) ──
# Google Gemini 키 (무료 등급 있음). https://aistudio.google.com/apikey 에서 발급한다.
# 이 값이 있으면 마중이는 Gemini를 쓴다.
GEMINI_API_KEY=
# 쓸 Gemini 모델 (비워 두면 가장 빠른 gemini-3.1-flash-lite. gemini-3.8-flash는 무료 한도가 하루 20회라 금방 바닥난다)
GEMINI_MODEL=
# 기본 모델이 붐빌 때(503·429) 차례로 넘어갈 모델, 쉼표로 구분 (비워 두면 gemini-3.5-flash,gemini-3.8-flash)
GEMINI_FALLBACK_MODELS=

# Anthropic(Claude) API 키. GEMINI_API_KEY가 비어 있을 때 쓴다.
ANTHROPIC_API_KEY=

# 둘 다 있을 때 직접 고르려면: gemini | anthropic (비워 두면 Gemini 우선)
LLM_PROVIDER=

# 메일 발송 모드: mock(기본) | real. 실제 발송은 P3 전까지 쓰지 않는다.
MAIL_MODE=mock
