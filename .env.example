# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# ── AI 모델 키 (둘 중 하나만 있어도 된다) ──
# Google Gemini 키 (무료 등급 있음). https://aistudio.google.com/apikey 에서 발급한다.
# 이 값이 있으면 마중이는 Gemini를 쓴다.
GEMINI_API_KEY=
# 쓸 Gemini 모델 (비워 두면 가장 빠른 gemini-3.1-flash-lite. gemini-3.8-flash는 무료 한도가 하루 20회라 금방 바닥난다)
GEMINI_MODEL=
# 기본 모델이 붐빌 때(503·429) 차례로 넘어갈 모델, 쉼표로 구분 (비워 두면 gemini-3.5-flash,gemini-3.8-flash)
GEMINI_FALLBACK_MODELS=

# Anthropic(Claude) API 키. GEMINI_API_KEY가 비어 있을 때 쓴다.
ANTHROPIC_API_KEY=

# 둘 다 있을 때 직접 고르려면: gemini | anthropic (비워 두면 Gemini 우선)
LLM_PROVIDER=

# 메일 발송 모드: mock(기본) | real. 실제 발송은 P3 전까지 쓰지 않는다.
MAIL_MODE=mock
# real일 때만 쓴다: Resend API 키, 보내는 주소, 받을 수 있는 팀 소유 주소 목록(쉼표 구분). 하나라도 비면 모의 발송으로 남는다.
RESEND_API_KEY=
MAIL_FROM=
MAIL_ALLOWLIST=

# ── 외부 연동 (자격이 없으면 비워 둔다. 비어 있으면 호출하지 않고 공식 사이트 연결만 보여 준다) ──
# Booking.com Demand API 3.2 (제휴 승인 필요). 기본은 샌드박스.
BOOKING_DEMAND_TOKEN=
BOOKING_AFFILIATE_ID=
# production으로 바꾸려면 BOOKING_DEMAND_ALLOW_PRODUCTION=1도 함께 넣는다 (개발·시연 중에는 쓰지 않는다)
BOOKING_DEMAND_ENV=
BOOKING_DEMAND_ALLOW_PRODUCTION=
# ODsay 대중교통 API 키 (경로의 시간·요금·막차, 버스 정류장 순서). https://lab.odsay.com
# 서버에서 부르므로 "서버" 플랫폼으로 등록하고 이 앱을 돌리는 컴퓨터(또는 배포 서버)의 공인 IP를 넣는다.
ODSAY_API_KEY=
# 다국어(영문·일문·중문·베트남어) 결과는 유료 서비스에서만 된다. 유료로 쓸 때만 1 (비워 두면 국문 결과)
ODSAY_MULTILANG=
# 공공데이터포털(data.go.kr) 일반 인증키 — "인천국제공항공사_여객편 운항현황(다국어)" 활용 신청 후 받는다 (자동 승인)
DATA_GO_KR_SERVICE_KEY=
