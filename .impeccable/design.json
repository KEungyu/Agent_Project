  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Charcoal signage control for ordinary submits (Send, Save, Add).",
      "html": "<button class=\"ds-btn\">Send</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:8px 18px;border:0;border-radius:var(--radius,6px);background:var(--signbar,#23272d);color:var(--on-dark,#fff);font:inherit;font-size:14px;font-weight:700;cursor:pointer;transition:background-color 140ms cubic-bezier(0.16,1,0.3,1),transform 140ms cubic-bezier(0.16,1,0.3,1)}.ds-btn:hover{background:#3b4149}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--arex,#0065b3);outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "White stroked control for secondary actions and editor toggles.",
      "html": "<button class=\"ds-btn-quiet\">Request changes</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;min-height:42px;padding:8px 14px;border:1px solid var(--rule-strong,#aab1ba);border-radius:var(--radius,6px);background:var(--sign,#fff);color:var(--ink,#15181c);font:inherit;font-size:14px;font-weight:600;cursor:pointer;transition:background-color 140ms cubic-bezier(0.16,1,0.3,1),border-color 140ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-quiet:hover{border-color:var(--ink-3,#626973);background:var(--ground,#e8ebee)}.ds-btn-quiet:active{transform:translateY(1px)}.ds-btn-quiet:focus-visible{outline:3px solid var(--arex,#0065b3);outline-offset:2px}"
    },
    {
      "name": "Approve Bar",
      "kind": "button",
      "refersTo": "button-approve",
      "description": "The lone full-width green bar for the one irreversible action.",
      "html": "<button class=\"ds-btn-approve\">Approve and send <svg viewBox=\"0 0 18 18\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M3 9h11M10 5l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></button>",
      "css": ".ds-btn-approve{display:flex;width:100%;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:12px 22px;border:0;border-radius:var(--radius,6px);background:var(--act-deep,#00813b);color:var(--on-dark,#fff);font:inherit;font-size:16px;font-weight:700;cursor:pointer;transition:background-color 140ms cubic-bezier(0.16,1,0.3,1),transform 140ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-approve:hover{background:#006b31}.ds-btn-approve:active{transform:translateY(1px)}.ds-btn-approve:focus-visible{outline:3px solid var(--arex,#0065b3);outline-offset:2px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Text input with AREX focus ring.",
      "html": "<input class=\"ds-field\" placeholder=\"Type a message\">",
      "css": ".ds-field{width:100%;min-height:42px;padding:8px 12px;border:1px solid var(--rule-strong,#aab1ba);border-radius:var(--radius,6px);background:var(--sign,#fff);color:var(--ink,#15181c);font:inherit;font-size:15px;font-weight:500;transition:border-color 140ms cubic-bezier(0.16,1,0.3,1),box-shadow 140ms cubic-bezier(0.16,1,0.3,1)}.ds-field::placeholder{color:var(--ink-3,#626973)}.ds-field:hover{border-color:var(--ink-3,#626973)}.ds-field:focus-visible{outline:none;border-color:var(--arex-deep,#004f8c);box-shadow:0 0 0 3px rgb(0 101 179 / 0.28)}"
    },
    {
      "name": "Execution Line Pill",
      "kind": "chip",
      "refersTo": "line-pill-act",
      "description": "Line-color badge carrying the Korean execution term and its translation.",
      "html": "<span class=\"ds-pill ds-pill-act\"><span class=\"ds-pill-ko\" lang=\"ko\">대행</span>We send it</span> <span class=\"ds-pill ds-pill-prep\"><span class=\"ds-pill-ko\" lang=\"ko\">준비</span>Prep</span> <span class=\"ds-pill ds-pill-info\"><span class=\"ds-pill-ko\" lang=\"ko\">안내</span>Info</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;min-height:26px;padding:3px 11px 3px 4px;border-radius:999px;font-size:13px;font-weight:600;line-height:1;white-space:nowrap}.ds-pill-ko{display:grid;place-items:center;min-width:34px;height:20px;padding:0 6px;border-radius:999px;background:var(--sign,#fff);font-size:12px;font-weight:800}.ds-pill-act{background:var(--act-deep,#00813b);color:var(--on-dark,#fff)}.ds-pill-act .ds-pill-ko{color:var(--act-deep,#00813b)}.ds-pill-prep{background:var(--prep,#ef7c1c);color:var(--ink,#15181c)}.ds-pill-prep .ds-pill-ko{color:var(--prep-deep,#a5500a)}.ds-pill-info{background:var(--info,#00a5de);color:var(--ink,#15181c)}.ds-pill-info .ds-pill-ko{color:var(--info-deep,#006c94)}"
    },
    {
      "name": "Exit Tile",
      "kind": "chip",
      "refersTo": "exit-tile",
      "description": "Yellow tool-call tile, shown only for calls that ran.",
      "html": "<span class=\"ds-exit\">get_board</span> <span class=\"ds-exit ds-exit-error\">draft_message</span>",
      "css": ".ds-exit{display:inline-block;padding:2px 7px;border-radius:3px;background:var(--exit,#ffcd00);color:var(--ink,#15181c);font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:11px;font-weight:700}.ds-exit-error{background:var(--alert-tint,#fbe5e5);color:var(--alert,#c0161c)}"
    },
    {
      "name": "Sign Panel",
      "kind": "card",
      "refersTo": "sign-panel",
      "description": "White sign with a full-bleed charcoal bilingual title bar.",
      "html": "<section class=\"ds-sign\"><h3 class=\"ds-sign-bar\"><span lang=\"ko\">항공편</span><span>Flights</span></h3><div class=\"ds-sign-row\"><span>Arrival in Korea</span><b>Oct 20, 00:40</b></div></section>",
      "css": ".ds-sign{overflow:hidden;padding:0 20px 20px;border:1px solid var(--rule,#d4d9de);border-radius:var(--radius,6px);background:var(--sign,#fff);box-shadow:0 1px 2px rgb(21 24 28 / 0.06),0 1px 1px rgb(21 24 28 / 0.04);color:var(--ink,#15181c)}.ds-sign-bar{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px;margin:0 -20px 18px;padding:12px 20px;background:var(--signbar,#23272d);font-size:13px;font-weight:500;color:var(--on-dark-2,#b8bec6)}.ds-sign-bar [lang=ko]{font-size:17px;font-weight:800;letter-spacing:-0.01em;color:var(--on-dark,#fff)}.ds-sign-row{display:flex;justify-content:space-between;gap:16px;font-size:14px;color:var(--ink-2,#4a5058)}.ds-sign-row b{color:var(--ink,#15181c);font-size:15px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Route Strip",
      "kind": "custom",
      "refersTo": "route-strip",
      "description": "A request's line with a sliding train marker at its current station.",
      "html": "<div class=\"ds-route\"><div class=\"ds-route-track\"><span class=\"ds-route-done\"></span><span class=\"ds-route-train\"></span></div><ol class=\"ds-route-stops\"><li class=\"p\"><i></i>Draft</li><li class=\"c\"><i></i>Waiting for approval</li><li><i></i>Sent</li><li><i></i>Waiting for reply</li><li><i></i>Done</li></ol></div>",
      "css": ".ds-route{--c:var(--act,#00a84d);--pos:0.25;position:relative;font-size:12px}.ds-route-track{container-type:inline-size;position:absolute;top:9px;left:10%;right:10%;height:4px;border-radius:2px;background:var(--rule,#d4d9de)}.ds-route-done{position:absolute;inset:0;border-radius:2px;background:var(--c);transform:scaleX(var(--pos));transform-origin:left}.ds-route-train{position:absolute;top:50%;left:0;z-index:2;width:30px;height:18px;border:3px solid #fff;border-radius:9px;background:var(--c);box-shadow:0 2px 6px rgb(21 24 28 / 0.25);transform:translate(calc(var(--pos) * 100cqi - 50%),-50%);transition:transform 520ms cubic-bezier(0.16,1,0.3,1)}.ds-route-stops{position:relative;display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;list-style:none}.ds-route-stops li{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;color:var(--ink-3,#626973)}.ds-route-stops i{position:relative;z-index:1;width:14px;height:14px;margin-top:4px;border:3px solid var(--rule-strong,#aab1ba);border-radius:50%;background:#fff;box-sizing:border-box}.ds-route-stops .p i{border-color:var(--c);background:var(--c)}.ds-route-stops .c{color:var(--ink,#15181c);font-weight:700}"
    },
    {
      "name": "Language Button",
      "kind": "nav",
      "refersTo": "lang-button",
      "description": "Flag plus native-name pill in the charcoal header.",
      "html": "<div style=\"background:#23272d;padding:12px\"><button class=\"ds-lang\"><svg width=\"20\" height=\"14\" viewBox=\"0 0 20 14\" aria-hidden=\"true\"><rect width=\"20\" height=\"14\" rx=\"2\" fill=\"#fff\"/><circle cx=\"10\" cy=\"7\" r=\"3.5\" fill=\"#c0161c\"/></svg>English<svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"M3 4.5l3 3 3-3\" fill=\"none\" stroke=\"#b8bec6\" stroke-width=\"1.5\"/></svg></button></div>",
      "css": ".ds-lang{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:6px 12px 6px 10px;border:1px solid var(--signbar-rule,#4a5058);border-radius:999px;background:var(--signbar-2,#31363d);color:var(--on-dark,#fff);font:inherit;font-size:14px;font-weight:600;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),border-color 160ms cubic-bezier(0.16,1,0.3,1)}.ds-lang:hover{background:#3b4149;border-color:var(--on-dark-2,#b8bec6)}.ds-lang:focus-visible{outline:3px solid var(--arex,#0065b3);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Seoul Metro Platform",
    "overview": "Majung reads like the Seoul Metro wayfinding system. The page is a platform: a cool concrete-gray ground carrying white sign panels, each headed by a charcoal signage bar. Every request is a line ridden station by station to its end, the trip itself is drawn as a line with cities as stations, and every sign carries Korean and the visitor's language together, Korean bold on top, translation beneath.\n\nLine colors are codes, not decoration. Line 2 green means 대행 (We send it), Line 3 orange means 준비 (Prep), Line 4 sky means 안내 (Info), AREX deep blue is Majung the agent and the trip line, and the yellow exit-number tile marks a tool call that actually ran. Each color appears at full strength where it codes something and nowhere else. Density is calm and legible enough for a phone at 1:30 AM and a classroom projector; hierarchy comes from scale and weight contrast within a single family, not from color or ornament.\n\nThe system refuses the default travel-app dashboard of rounded white cards with a floating chat bubble: panels are square-shouldered signs, the chat is a fixed information desk, and the one irreversible action (approving a send) sits alone on a full-width green bar.",
    "keyCharacteristics": [
      "Concrete-gray ground, white sign panels, charcoal signage bar on every panel title.",
      "Bilingual stacks everywhere: Korean (800 weight) first, user language (500 weight, ink-2) beside or beneath.",
      "Line color as code at full strength; never decorative, never tinted into backgrounds except selection and hover states of the AREX/Info family.",
      "Roundels (station-number circles) for airports, the agent, and the brand.",
      "One signature motion: the train marker slides along a request's route strip to its next station."
    ],
    "rules": [
      {
        "name": "The Line Code Rule",
        "body": "A line color appears only where it codes its meaning: green for 대행, orange for 준비, sky for 안내, AREX for the agent and the trip, yellow for a tool call that ran. No line color is used as generic accent or decoration.",
        "section": "colors"
      },
      {
        "name": "The AREX Is Not Line 4 Rule",
        "body": "AREX deep blue and Line 4 sky are distinct and must stay distinct: the agent is never drawn in sky, and Info is never drawn in AREX blue.",
        "section": "colors"
      },
      {
        "name": "The Honest Exit Rule",
        "body": "Yellow exit tiles appear only for tool calls that actually executed; a failed call shows in alert-tint, and no tile is drawn for an intended or hypothetical call.",
        "section": "colors"
      },
      {
        "name": "The Bilingual Stack Rule",
        "body": "Every sign title is Korean first at 800 weight, the user's language second at 500 weight in ink-2 (on-dark-2 on charcoal). On the Korean UI the second line is omitted, never duplicated.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Times, dates, booking numbers and flight data use tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Keep-All Rule",
        "body": "Korean text never breaks mid-word (word-break: keep-all); Thai runs at line-height 1.7.",
        "section": "typography"
      },
      {
        "name": "The Flat Platform Rule",
        "body": "Signs rest flat; only floating or awaiting-action surfaces lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** head every sign panel with a full-bleed charcoal bar carrying Korean and the user's language.",
      "**Do** use line colors only as codes: act for 대행, prep for 준비, info for 안내, AREX for the agent and trip, exit yellow for executed tool calls.",
      "**Do** keep AREX (#0065b3) and Line 4 sky (#00a5de) visually separate in every new surface.",
      "**Do** isolate an irreversible action on its own full-width act-deep bar, with secondary actions above it.",
      "**Do** use deep line variants (act-deep, prep-deep, info-deep, arex-deep) whenever line-colored text or a fill carrying white text sits on white.",
      "**Do** draw sequences as lines with station dots and roundels, vertical on narrow screens.",
      "**Do** use tabular figures for times, dates and reference numbers."
    ],
    "donts": [
      "**Don't** introduce a second display face or a decorative script; Pretendard carries every role.",
      "**Don't** use a line color as a generic accent, background wash, or decorative stripe.",
      "**Don't** draw a multi-color line stripe in the header; the header carries one AREX rule.",
      "**Don't** show a 확정 (confirmed) badge or any badge without its Korean term.",
      "**Don't** draw an exit tile for a tool call that did not run.",
      "**Don't** use emoji for flags; flags are authored SVG with a 1px hairline ring and 2px radius."
    ]
  }
}